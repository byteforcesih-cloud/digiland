{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI Backend (DigiLand)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Run Pytest Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "tests/test_api.py"
      ],
      "cwd": "${workspaceFolder}/backend"
    }
  ]
}
